# LAN address or hostname of the DHO804 oscilloscope.
RIGOL_SCOPE_HOST=192.168.1.8

# The verified raw SCPI/TCP port from the oscilloscope's LAN configuration.
# Verified raw SCPI/TCP port; *IDN? succeeds on this endpoint.
RIGOL_SCOPE_PORT=5555

# DHO-series ADB service used by the web Sleep button. 55555 is the usual DHO-series port.
RIGOL_SCOPE_ADB_PORT=55555

# Set to 1 temporarily to log SCPI query timing, TCP receive progress, and instrument subscription lifecycle.
RIGOL_SCPI_DEBUG=0

# LAN address and verified raw SCPI/TCP port of the DM858E multimeter.
RIGOL_DMM_HOST=127.0.0.1
RIGOL_DMM_PORT=1
