# LAN address or hostname of the DHO804 oscilloscope.
RIGOL_SCOPE_HOST=192.168.1.x

# The verified raw SCPI/TCP port from the oscilloscope's LAN configuration.
# Do not assume the port; the device is currently offline and could not be probed.
RIGOL_SCOPE_PORT=replace-with-verified-scpi-port

# LAN address and verified raw SCPI/TCP port of the DM858E multimeter.
RIGOL_DMM_HOST=127.0.0.1
RIGOL_DMM_PORT=1
